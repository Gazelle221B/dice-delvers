{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dice Delvers",
  "version": "0.1.0",
  "identifier": "io.github.gazelle221b.dicedelvers",
  "build": {
    "frontendDist": "../crates/app/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../crates/app", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../crates/app" }
  },
  "app": {
    "windows": [
      { "title": "Dice Delvers", "width": 1280, "height": 800, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
